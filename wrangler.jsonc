{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radixdao-pricing-service",
  "main": "src/index.ts",
  // Radix DAO Cloudflare account
  "account_id": "cdb0453c60d48cf58f44f34f9eb6bbe2",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pricing-service",
      "database_id": "d27711b4-5259-4651-abe5-57145730be8f",
      "migrations_dir": "migrations"
    }
  ],
  // Defaults live in src/settings.ts; override here only when needed.
  // Secrets (wrangler secret put): API_KEY, COINGECKO_API_KEY, GITHUB_ALERT_TOKEN
  "vars": {
    "ALERT_REPO": "RadixDAO/pricing-service"
  }
  // prices.radixdao.org is served by the "prices" Worker (Timan's port) for now; move it here
  // only in agreement with Timan, after comparing both side by side.
  // "routes": [{ "pattern": "prices.radixdao.org", "custom_domain": true }]
}
